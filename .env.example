# Copia este archivo a .env.local y llena los valores.
# Proyecto Supabase: Axl-Projects (compartido con reels-analytics y admin-home).

# --- Supabase ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://impscwgourdxhdejwkhe.supabase.co

# Llave publicable, la que usa el panel. Es segura de exponer en el browser:
# lo que protege los datos es RLS, no esconder la llave.
# Supabase > Project Settings > API Keys > publishable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Salta RLS por completo. Solo para scripts de administracion (dar de alta
# admins). NUNCA se importa desde src/ ni se sube a Vercel.
# Supabase > Project Settings > API Keys > secret key (boton Reveal).
SUPABASE_SECRET_KEY=

# --- App --------------------------------------------------------------------

# URL publica donde vive el panel, sin diagonal al final.
# Local: http://localhost:3000 | Produccion: https://admin.adala.mx
# Se usa para armar URLs absolutas (metadata, y mas adelante los redirects de
# recuperacion de contrasena de Supabase Auth).
NEXT_PUBLIC_APP_URL=http://localhost:3000
